# Copier en .env.test (ignoré par git) et renseigner les valeurs locales.
# Le compte est créé par : php artisan db:seed --class=E2eClubAccountSeeder
# N'utilisez jamais ici un compte existant en production.

PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_CLUB_EMAIL=e2e-club@example.test
E2E_CLUB_PASSWORD=changeme-local-only

# Double authentification du compte club (obligatoire) : secret TOTP en base32 et
# jeton d'appareil de confiance, à générer localement, par exemple :
#   php -r "require 'vendor/autoload.php'; echo (new PragmaRX\Google2FA\Google2FA)->generateSecretKey(32), PHP_EOL;"
#   openssl rand -hex 32
E2E_CLUB_TOTP_SECRET=
E2E_CLUB_DEVICE_TOKEN=
